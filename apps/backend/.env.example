DETECTION_TOKEN=""
JWT_SECRET=""
# Per-agent API keys an MCP client must send (as a Bearer token) to reach
# /v1/mcp -- JSON object, label -> token. Add/remove an entry and restart
# to add/revoke one person or agent without touching anyone else's key.
# Still a stand-in for real OAuth 2.1 (see docs/knowledge/mcp-notes.md).
# Generate a new token with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_API_KEYS={}
PORT=1370
DETECTION_PROVIDER_TIMEOUT_MS=30000
DETECTION_PROVIDER_RETRIES=5
DETECTION_PROVIDER_RETRY_DELAY_MS=200
# CORS
CORS_ORIGIN=""
CORS_ORIGIN_DEVELOPMENT="http://localhost:5173"
CORS_HEADERS="Content-Type, Authorization"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_MAX_AGE=86400
CORS_CREDENTIALS="true"
# Content-Disposition must stay listed: the export zip download reads the
# server-provided filename from it, and cross-origin JS cannot see it otherwise.
CORS_EXPOSE_HEADERS="Content-Length, Authorization, Content-Disposition"
# Output log
ENABLE_CONSOLE_LOG=1
ENABLE_LOG=0
# EEZ/MPA/coastline boundary geometry: "simplified" (default, fits a memory-
# constrained host) or "full" (unsimplified upstream geometry -- needs a host
# with enough RAM; see docs/data/context-layers.md).
CONTEXT_DATASET_QUALITY=simplified
