DETECTION_TOKEN=""
JWT_SECRET=""
PORT=1370
# CORS
CORS_ORIGIN=""
CORS_ORIGIN_DEVELOPMENT="http://localhost:5173"
CORS_HEADERS="Content-Type, Authorization"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_MAX_AGE=86400
CORS_CREDENTIALS="true"
# Content-Disposition must stay listed: the export zip download reads the
# server-provided filename from it, and cross-origin JS cannot see it otherwise.
CORS_EXPOSE_HEADERS="Content-Length, Authorization, Content-Disposition"
# Output log
ENABLE_CONSOLE_LOG=1
ENABLE_LOG=0
